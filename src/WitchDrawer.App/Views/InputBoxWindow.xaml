<Window x:Class="WitchDrawer.App.Views.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=EntryBox}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowActivated="True">
    <Border Margin="12"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,16"
            MinWidth="300"
            MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Color="#000000"
                              Opacity="0.28"
                              ShadowDepth="4"
                              Direction="270" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,14" />
            <TextBox x:Name="EntryBox"
                     Height="32"
                     Padding="8,4"
                     FontSize="13"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Background="{DynamicResource BorderBrushSoft}"
                     BorderBrush="{DynamicResource BorderBrushSoft}"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     KeyDown="OnEntryKeyDown" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="76"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button x:Name="OkButton"
                        Content="确定"
                        Width="76"
                        Height="30"
                        Click="OnOkClick"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>