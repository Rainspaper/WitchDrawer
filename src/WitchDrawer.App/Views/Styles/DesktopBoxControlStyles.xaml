<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pure control chrome. Keep interaction handlers in DesktopBoxWindow. -->
    <Storyboard x:Key="ScrollDashes" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="DashRect"
                         Storyboard.TargetProperty="StrokeDashOffset"
                         From="0"
                         To="7"
                         Duration="0:0:0.6" />
    </Storyboard>

    <Style x:Key="MappingModeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Opacity" Value="0.50" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 多标签总盒子的标签卡（标题栏下方一行，列出全部已收纳的盒子）。
         宽度不写死在这里：由 ItemTemplate 里的多值绑定按「标签栏宽度 ÷ 标签数」算，
         夹在 TabChipMetrics 的上下限之间（标签多到低于下限才横向滚动）。
         文字过长时省略号截断（悬停有完整名 ToolTip）；必须 TextTrimming 截断，
         不能任其溢出，否则相邻标签文字会互相叠压。
         底色只取盒子自身用到的那套画刷（GlassInnerBrush / HoverBrush / GlassStrokeBrush），
         它们会被盒子按「主题 + 盒子不透明度」重写进窗口资源，所以标签栏外观与盒子原本设置同步，
         不会出现与盒子表面不同材质的色块。
         选中项只做轻微高亮：盒子内面色 + 主题强调色文字 + 一圈细描边，不加粗、不换字重（避免文字抖动）。 -->
    <Style x:Key="TabChipButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!-- 恒为 1：选中项才显示描边，固定厚度可避免选中时文字位移 1px。 -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 同一模板内多个触发器按声明顺序生效，后声明者优先：
                             选中态放在最后，保证活动标签悬停时也不会丢掉高亮。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{DynamicResource GlassInnerBrush}" />
                            <Setter TargetName="Chip"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GlassStrokeBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPixelStyle}" Value="True">
                            <Setter TargetName="Chip" Property="CornerRadius" Value="4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TodoCompletionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="CompletionRing"
                                 Fill="{DynamicResource GlassInnerBrush}"
                                 Stroke="{DynamicResource BorderBrushSoft}"
                                 StrokeThickness="1.4" />
                        <Path x:Name="CompletionCheck"
                              Data="M 4.5,9.5 L 7.6,12.4 L 14.4,5.8"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter TargetName="CompletionRing"
                                    Property="Fill"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="CompletionRing"
                                    Property="Stroke"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="CompletionCheck"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CompletionRing"
                                    Property="Stroke"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TodoArchiveButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ArchiveRoot"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArchiveRoot"
                                    Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
